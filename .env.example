# Copy to .env and edit
PORT=3010
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-string
# First admin account (only used when the database is empty)
ADMIN_EMAIL=admin@paulibytenews.com
ADMIN_NAME=PaulibyteNews Desk
# ADMIN_PASSWORD=   (leave empty to auto-generate; it is printed and saved to data/FIRST_LOGIN.txt)
# Set to 0 to start with an empty site (no demo articles)
SEED_DEMO=1
