<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title>Sign in · <%= s.site_name %></title><link rel="icon" href="/img/favicon.svg">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Manrope:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css?v=1"></head>
<body class="login-page">
  <form method="post" class="login-card">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <a href="/" class="a-brand"><%- include('../partials/logo') %><span>Paulibyte<b>News</b></span></a>
    <h1>Newsroom sign in</h1>
    <p>For PaulibyteNews admins, editors and contributors.</p>
    <% if (error) { %><div class="a-error"><%= error %></div><% } %>
    <label>Email<input type="email" name="email" value="<%= email %>" required autofocus autocomplete="username"></label>
    <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="a-btn a-btn-primary">Sign in</button>
    <a href="/" class="login-back">← Back to the site</a>
  </form>
</body></html>
