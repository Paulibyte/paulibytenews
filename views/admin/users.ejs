<%- include('_head') %>
<div class="a-grid2 wide-left">
  <section class="a-card">
    <h2>Team</h2>
    <p class="a-muted"><strong>Admin</strong> — everything, incl. ads, team & settings. <strong>Editor-in-Chief</strong> — edits & publishes all articles, manages lab, sections, comments. <strong>Contributor</strong> — writes drafts and submits them for review; posts lab notes on products they test.</p>
    <% for (const u of users) { %>
    <form method="post" action="/admin/users" class="a-user <%= u.active ? '' : 'a-off' %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= u.id %>">
      <span class="a-av"><% if (u.avatar) { %><img src="<%= u.avatar %>" alt=""><% } else { %><%= u.name[0] %><% } %></span>
      <input name="name" value="<%= u.name %>" aria-label="Name">
      <input name="email" type="email" value="<%= u.email %>" aria-label="Email">
      <select name="role" aria-label="Role"><% for (const r of ['admin','editor','contributor']) { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= ROLE_NAME[r] %></option><% } %></select>
      <input name="password" type="password" placeholder="New password" aria-label="New password" autocomplete="new-password">
      <label class="a-check"><input type="checkbox" name="active" value="1" <%= u.active ? 'checked' : '' %>> Active</label>
      <span class="a-muted"><%= u.n %> published</span>
      <button class="a-btn a-btn-sm">Save</button>
    </form>
    <% } %>
  </section>
  <section class="a-card">
    <h2>Add team member</h2>
    <form method="post" action="/admin/users" class="a-stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Full name<input name="name" required></label>
      <label>Email<input name="email" type="email" required></label>
      <label>Role<select name="role"><option value="contributor">Contributor</option><option value="editor">Editor-in-Chief</option><option value="admin">Admin</option></select></label>
      <label>Temporary password<input name="password" type="password" minlength="8" required autocomplete="new-password"></label>
      <button class="a-btn a-btn-primary">Add member</button>
    </form>
    <p class="a-muted">Deactivate instead of deleting so their bylines stay on published articles.</p>
  </section>
</div>
<%- include('_foot') %>
