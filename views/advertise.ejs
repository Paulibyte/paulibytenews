<%- include('partials/head') %>
<section class="lab-hero adv-hero">
  <div class="wrap">
    <span class="eyebrow">Partner with PaulibyteNews</span>
    <h1>Advertise with us</h1>
    <div class="adv-intro"><%- s.advertise_html %></div>
    <a class="btn btn-accent" href="#enquire">Request a media kit</a>
  </div>
</section>
<div class="wrap">
  <section class="lab-section">
    <div class="sec-head"><h2>Placements</h2></div>
    <div class="rate-grid">
      <% for (const r of rates) { %>
      <div class="rate-card"><strong><%= r[0] %></strong><span class="rate-size"><%= r[1] || '' %></span><p><%= r[2] || '' %></p></div>
      <% } %>
    </div>
  </section>
  <section class="lab-section enquire" id="enquire">
    <div class="sec-head"><h2>Send an enquiry</h2></div>
    <% if (sent) { %><div class="flash">Thank you — our ads team will get back to you shortly at the email you provided.</div><% } %>
    <form method="post" action="/advertise" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label>Your name<input name="name" required></label>
      <label>Company / brand<input name="company"></label>
      <label>Email<input name="email" type="email" required></label>
      <label>Phone / WhatsApp<input name="phone"></label>
      <label class="full">Interested in
        <select name="package"><option value="">Choose…</option><% for (const r of rates) { %><option><%= r[0] %></option><% } %><option>Custom package</option></select></label>
      <label class="full">Tell us about your campaign<textarea name="message" rows="5"></textarea></label>
      <button class="btn btn-accent">Send enquiry</button>
    </form>
    <p class="muted">Prefer email? Write to <a href="mailto:<%= s.ads_email %>"><%= s.ads_email %></a>.</p>
  </section>
</div>
<%- include('partials/foot') %>
