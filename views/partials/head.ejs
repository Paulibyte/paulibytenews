<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<% const pageTitle = (typeof title !== 'undefined' && title) ? `${title} | ${s.site_name}` : `${s.site_name} — ${s.tagline}`;
   const desc = (typeof description !== 'undefined' && description) ? description : s.tagline;
   const og = (typeof ogImage !== 'undefined' && ogImage) ? (ogImage.startsWith('http') ? ogImage : s.site_url + ogImage) : s.site_url + '/img/og-default.png'; %>
<title><%= pageTitle %></title>
<meta name="description" content="<%= desc %>">
<link rel="canonical" href="<%= s.site_url + path %>">
<meta property="og:site_name" content="<%= s.site_name %>">
<meta property="og:title" content="<%= (typeof title !== 'undefined' && title) || s.site_name %>">
<meta property="og:description" content="<%= desc %>">
<meta property="og:type" content="<%= (typeof ogType !== 'undefined' && ogType) || 'website' %>">
<meta property="og:url" content="<%= s.site_url + path %>">
<meta property="og:image" content="<%= og %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0A0E1A">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/icon-192.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="alternate" type="application/rss+xml" title="<%= s.site_name %>" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css?v=1">
<script>try{if(localStorage.getItem('pbn-theme')==='dark'||(!localStorage.getItem('pbn-theme')&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark')}catch(e){}</script>
<% if (s.adsense_client) { %><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= s.adsense_client %>" crossorigin="anonymous"></script><% } %>
<%- s.head_code || '' %>
<% if (typeof jsonld !== 'undefined' && jsonld) { %><script type="application/ld+json"><%- JSON.stringify(jsonld).replace(/</g, '\\u003c') %></script><% } %>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<div class="topbar">
  <div class="wrap topbar-in">
    <span class="today" data-today></span>
    <% if (breaking.length) { %>
    <div class="ticker" aria-label="Breaking news">
      <span class="ticker-tag">Breaking</span>
      <div class="ticker-track"><div class="ticker-move">
        <% for (const b of breaking.concat(breaking)) { %><a href="<%= b.url %>"><%= b.title %></a><% } %>
      </div></div>
    </div>
    <% } else { %><span class="topbar-tag"><%= s.tagline %></span><% } %>
    <div class="topbar-links">
      <a href="/advertise">Advertise</a>
      <a href="/feed.xml" aria-label="RSS feed">RSS</a>
      <% if (me) { %><a href="/admin">Dashboard</a><% } else { %><a href="/admin/login">Sign in</a><% } %>
    </div>
  </div>
</div>

<header class="masthead">
  <div class="wrap mast-in">
    <button class="icon-btn menu-btn" data-open-drawer aria-label="Open menu"><svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
    <a class="brand" href="/" aria-label="<%= s.site_name %> home">
      <%- include('logo') %>
      <span class="brand-word">Paulibyte<b>News</b></span>
    </a>
    <nav class="mainnav" aria-label="Sections">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Home</a>
      <a href="/reviews" class="<%= path.startsWith('/reviews') ? 'on' : '' %>">Reviews</a>
      <a href="/lab" class="nav-lab <%= path.startsWith('/lab') ? 'on' : '' %>"><span class="live-dot"></span>Review Lab</a>
      <% for (const c of navCats.slice(0, 6)) { %><a href="/category/<%= c.slug %>" class="<%= path === '/category/' + c.slug ? 'on' : '' %>"><%= c.name %></a><% } %>
    </nav>
    <div class="mast-actions">
      <button class="icon-btn" data-search-toggle aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <button class="icon-btn" data-theme-toggle aria-label="Toggle dark mode"><svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
      <a class="btn btn-sm btn-accent hide-sm" href="#newsletter">Subscribe</a>
    </div>
  </div>
  <form class="searchbar" action="/search" role="search" hidden>
    <div class="wrap"><input name="q" type="search" placeholder="Search news, reviews, gadgets…" value="<%= typeof q !== 'undefined' ? q : '' %>" aria-label="Search"><button class="btn btn-accent">Search</button></div>
  </form>
  <nav class="subnav" aria-label="All categories"><div class="wrap subnav-in">
    <% for (const c of navCats) { %><a href="/category/<%= c.slug %>" style="--c:<%= c.color %>"><%= c.name %></a><% } %>
    <a href="/type/howto" style="--c:#0EA371">How-To</a><a href="/type/opinion" style="--c:#8B5CF6">Opinion</a>
  </div></nav>
</header>

<aside class="drawer" data-drawer aria-hidden="true">
  <div class="drawer-panel">
    <div class="drawer-head"><span class="brand-word">Paulibyte<b>News</b></span><button class="icon-btn" data-close-drawer aria-label="Close menu"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form action="/search" class="drawer-search"><input name="q" type="search" placeholder="Search…" aria-label="Search"></form>
    <a href="/">Home</a><a href="/reviews">Reviews</a><a href="/lab"><span class="live-dot"></span>Review Lab</a>
    <div class="drawer-label">Sections</div>
    <% for (const c of navCats) { %><a href="/category/<%= c.slug %>"><i style="background:<%= c.color %>"></i><%= c.name %></a><% } %>
    <a href="/type/howto"><i style="background:#0EA371"></i>How-To</a><a href="/type/opinion"><i style="background:#8B5CF6"></i>Opinion</a>
    <div class="drawer-label">PaulibyteNews</div>
    <a href="/about">About us</a><a href="/advertise">Advertise</a><a href="/feed.xml">RSS feed</a>
    <% if (me) { %><a href="/admin">Dashboard</a><% } else { %><a href="/admin/login">Writer sign in</a><% } %>
  </div>
</aside>

<div class="wrap header-ad"><%- zone('header', { placeholder: true }) %></div>
<% if (flash) { %><div class="wrap"><div class="flash"><%= flash %></div></div><% } %>
<main id="main">
